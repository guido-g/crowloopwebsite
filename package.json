{
  "name": "crow-loop-studio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sandbox": "ampx sandbox",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/mclaren": "^5.3.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.24.0",
    "@aws-amplify/backend-cli": "^1.9.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
